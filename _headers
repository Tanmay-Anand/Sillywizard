# Cloudflare Pages / Netlify. Vercel reads vercel.json instead; each host
# ignores the other's file, so both can live here.

# Generated by tools/make-og.py and changed only when it runs.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# These change every time the wizard is tuned. A cached substrate.js against a
# fresh site.css is a bug that only reproduces in someone else's browser.
/css/*
  Cache-Control: public, max-age=0, must-revalidate
/js/*
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  # ONE DAY, not one year, until you have watched it work. HSTS is cached by
  # the browser and cannot be withdrawn early: ship max-age=31536000 with a
  # broken certificate and visitors are locked out for a year. Raise it once
  # HTTPS has been correct for a week.
  Strict-Transport-Security: max-age=86400; includeSubDomains
  # 'unsafe-inline' for script is deliberate: the build switch and the script
  # loader are inline in <head> BY DESIGN — moving them to files reintroduces
  # the pre-paint flash they exist to prevent. This is a static site with no
  # user input and no backend, so there is no injection path for a CSP to
  # close; it is here as defence-in-depth if the host is ever compromised.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'
