# The whole repo root is the assets directory, so everything that is not the
# site has to be excluded here or it becomes a public URL.
.git
.gitignore
.gitattributes
.assetsignore
.claude
wrangler.jsonc
vercel.json
*.md
tools
serve.py
assets/options
assets/ref/README.txt
node_modules

# Test and CI tooling - never part of the site.
tests
coverage
.github
.husky
package.json
package-lock.json
vitest.config.mjs
